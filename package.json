{
	"name": "ezconv",
	"type": "module",
	"private": true,
	"scripts": {
		"install:all": "bun install && bun install --cwd client",
		"dev": "bun run --cwd client dev",
		"build": "bun run --cwd client build",
		"preview": "bun run --cwd client preview",
		"test": "bun run --cwd client test --run",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"release:prepare": "bun scripts/release.mjs",
		"release:validate": "bun scripts/release.mjs --validate"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7"
	},
	"packageManager": "bun@1.4.4",
	"version": "2.0.0"
}
